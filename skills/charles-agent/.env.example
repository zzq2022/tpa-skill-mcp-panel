# ==========================================
# Charles Agent 环境配置模板
# ==========================================
# 复制此文件为 .env 并填入实际值

# ------------------------------------------
# LLM 配置（必需）
# ------------------------------------------
# 支持 OpenAI 兼容的 API（Kimi、DeepSeek、智谱等）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.kimi.com/coding/v1
OPENAI_MODEL=kimi-for-coding

# ------------------------------------------
# Embedding 配置（必需，用于 RAG 检索）
# ------------------------------------------
# 推荐：SiliconFlow 的 BAAI/bge-large-zh-v1.5（中文优化）
EMBEDDING_API_KEY=sk-your-embedding-key-here
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_BASE_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_CHUNK_SIZE=400
EMBEDDING_CHUNK_OVERLAP=80

# ------------------------------------------
# 配置说明
# ------------------------------------------
# 1. API Key 获取：
#    - Kimi: https://platform.moonshot.cn/
#    - SiliconFlow: https://siliconflow.cn/
#    - DeepSeek: https://platform.deepseek.com/
#
# 2. 验证配置：
#    python runtime/preflight.py
#
# 3. 测试运行：
#    python runtime/tpa_entry.py --objective "测试任务" --subject "测试公司"
